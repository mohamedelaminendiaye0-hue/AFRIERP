# ===========================================================================
#  ÉTAPE 1 : copiez ce fichier en ".env" puis remplissez vos valeurs
#            cp .env.example .env
#  (le fichier .env ne doit JAMAIS être commité — voir .gitignore)
# ===========================================================================

# --- Choix du fournisseur de modèle : "together" ou "ollama" ---------------
PROVIDER=together

# --- Fournisseur 1 : Together AI (cloud) -----------------------------------
# 👉 METTEZ VOTRE CLÉ TOGETHER AI ICI (obligatoire si PROVIDER=together)
TOGETHER_API_KEY=collez_votre_cle_together_ai_ici
TOGETHER_BASE_URL=https://api.together.xyz/v1
# Modèle Together qui supporte le tool-calling :
TOGETHER_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# --- Fournisseur 2 : Ollama (local) ----------------------------------------
# Utilisé seulement si PROVIDER=ollama. Pas de clé nécessaire.
OLLAMA_BASE_URL=http://localhost:11434
# ⚠️ Le modèle DOIT supporter le tool-calling (ex. qwen2.5, llama3.1, mistral-nemo)
OLLAMA_MODEL=qwen2.5:7b

# --- Paramètres de la mission ----------------------------------------------
TARGET_URL=http://localhost:3000
# Hôtes autorisés (séparés par des virgules). L'agent ne peut PAS en sortir.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Observabilité (optionnel mais recommandé) -----------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=collez_votre_cle_langsmith_ici
